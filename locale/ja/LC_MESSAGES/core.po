#: dupeguru/core/app.py:44
msgid "There are no marked duplicates. Nothing has been done."
msgstr "チェックを入れた重複はありません。 何も行われませんでした。"

#: dupeguru/core/app.py:45
msgid "There are no selected duplicates. Nothing has been done."
msgstr "選択された重複はありません。 何も行われていません。"

#: dupeguru/core/app.py:46
msgid ""
"The file is not under any folder in the Directories panel. Can't recreate "
"relative path."
msgstr "ファイルはディレクトリパネルのどのフォルダーにもありません。相対パスを再作成できません。"

#: dupeguru/core/app.py:47
msgid ""
"You're about to open many files at once. Depending on what those files are "
"opened with, doing so can create quite a mess. Continue?"
msgstr "一度に多くのファイルを開こうとしています。 これらのファイルを開く対象によっては、これを行うとかなり混乱する可能性があります。 継続する？"

#: dupeguru/core/app.py:51
msgid "{} of the {} marked files are reference files!"
msgstr "マークされたファイル（全 {} 個）のうち {} 個が参照ファイルです。"

#: dupeguru/core/app.py:52
msgid "{} of the {} selected files are reference files!"
msgstr "選択された {} ファイルのうち {} ファイルが参照ファイルです。"

#: dupeguru/core/app.py:53
msgid ""
"Deleted files can't be replaced with links while reference files are marked:"
" the links would point to files being deleted. Nothing has been done."
msgstr ""
"参照ファイルにマークが付いている間は、削除されたファイルをリンクに置き換えることはできません。リンク先が削除されるファイルになってしまうためです。何も実行されませんでした。"

#: dupeguru/core/app.py:80
msgid "Scanning for duplicates"
msgstr "重複のスキャン"

#: dupeguru/core/app.py:81
msgid "Loading"
msgstr "読み込み中"

#: dupeguru/core/app.py:82
msgid "Moving"
msgstr "移動します"

#: dupeguru/core/app.py:83
msgid "Copying"
msgstr "コピー中"

#: dupeguru/core/app.py:84
msgid "Sending to Trash"
msgstr "ごみ箱に送信します"

#: dupeguru/core/app.py:301
msgid ""
"A previous action is still hanging in there. You can't start a new one yet. "
"Wait a few seconds, then try again."
msgstr "前のアクションはまだそこにぶら下がっています。 まだ新しいものを始めることはできません。 数秒待ってから、再試行してください。"

#: dupeguru/core/app.py:312
msgid "No duplicates found."
msgstr "重複は見つかりませんでした。"

#: dupeguru/core/app.py:327
msgid "All marked files were copied successfully."
msgstr "チェックを入れたファイルをすべてコピーしました。"

#: dupeguru/core/app.py:329
msgid "All marked files were moved successfully."
msgstr "チェックを入れたファイルをすべて移動しました。"

#: dupeguru/core/app.py:331
msgid "All marked files were deleted successfully."
msgstr "チェックを入れたファイルをすべて削除しました。"

#: dupeguru/core/app.py:333
msgid "All marked files were successfully sent to Trash."
msgstr "チェックを入れたファイルをすべてごみ箱に移動しました。"

#: dupeguru/core/app.py:338
msgid "Could not load file: {}"
msgstr "ファイルを読み込めませんでした：{}"

#: dupeguru/core/app.py:405
msgid "'{}' already is in the list."
msgstr "「{}」既にリストに含まれています。"

#: dupeguru/core/app.py:408
msgid ""
"'{}' could not be read. It might be on a disconnected network share, or you "
"might not have the permission to access it."
msgstr "「{}」を読み込めませんでした。接続されていないネットワーク共有上にあるか、アクセス権限がない可能性があります。"

#: dupeguru/core/app.py:414
msgid "'{}' does not exist."
msgstr "'{}' 存在しません。"

#: dupeguru/core/app.py:422
msgid ""
"All selected %d matches are going to be ignored in all subsequent scans. "
"Continue?"
msgstr "選択した%d個の一致は、以降のすべてのスキャンで無視されます。 継続する？"

#: dupeguru/core/app.py:506
msgid "Select a directory to copy marked files to"
msgstr "マークされたファイルをコピーするディレクトリを選択してください"

#: dupeguru/core/app.py:508
msgid "Select a directory to move marked files to"
msgstr "マークされたファイルを移動するディレクトリを選択してください"

#: dupeguru/core/app.py:554
msgid "Select a destination for your exported CSV"
msgstr "エクスポートしたCSVの宛先を選択します。"

#: dupeguru/core/app.py:560 dupeguru/core/app.py:830 dupeguru/core/app.py:840
msgid "Couldn't write to file: {}"
msgstr "ファイルに書き込めませんでした：{}"

#: dupeguru/core/app.py:584
msgid "You have no custom command set up. Set it up in your preferences."
msgstr "カスタムコマンドは設定されていません。 お好みで設定してください。"

#: dupeguru/core/app.py:600
msgid "Invalid custom command syntax: {}"
msgstr "カスタムコマンドの構文が無効です: {}"

#: dupeguru/core/app.py:610
msgid "Failed to execute custom command: {}"
msgstr "カスタムコマンドの実行に失敗しました：{}"

#: dupeguru/core/app.py:753 dupeguru/core/app.py:765
msgid "You are about to remove %d files from results. Continue?"
msgstr "結果から%d個のファイルを削除しようとしています。 継続する？"

#: dupeguru/core/app.py:802
msgid "{} duplicate groups were changed by the re-prioritization."
msgstr "{}重複するグループは、再優先順位付けによって変更されました。"

#: dupeguru/core/app.py:850
msgid "The selected directories contain no scannable file."
msgstr "選択したディレクトリにはスキャン可能なファイルが含まれていません。"

#: dupeguru/core/app.py:866
msgid "Collecting files to scan"
msgstr "スキャンするファイルを収集しています"

#: dupeguru/core/app.py:932
msgid "%s (%d discarded)"
msgstr "%s (%d 廃棄)"

#: dupeguru/core/directories.py:227
msgid "Collected {} files to scan"
msgstr "スキャン用に{}個のファイルを収集しました"

#: dupeguru/core/directories.py:243
msgid "Collected {} folders to scan"
msgstr "スキャンする{}フォルダーを収集しました"

#: dupeguru/core/engine.py:27
msgid "%d matches found from %d groups"
msgstr "%d個のグループから%d件の一致が見つかりました"

#: dupeguru/core/gui/deletion_options.py:71
msgid "You are sending {} file(s) to the Trash."
msgstr "{}個のファイルをゴミ箱に送信しています"

#: dupeguru/core/gui/exclude_list_table.py:14
msgid "Regular Expressions"
msgstr "正規表現"

#: dupeguru/core/gui/ignore_list_dialog.py:25
msgid "Do you really want to remove all %d items from the ignore list?"
msgstr "本当に除外リストから%d個の項目を削除しますか？"

